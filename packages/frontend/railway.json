{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install && pnpm --filter frontend build",
    "watchPatterns": [
      "/packages/frontend/**",
      "/packages/ui-components/**"
    ]
  },
  "deploy": {
    "runtime": "V2",
    "numReplicas": 1,
    "startCommand": "pnpm --filter frontend start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300
  }
}
