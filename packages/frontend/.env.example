# Frontend environment variables
# For local development, points to local backend
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk Authentication
# Get these from https://dashboard.clerk.com → Your App → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk URLs (optional - defaults work for most cases)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Resend Email - Get API key from https://resend.com/api-keys
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Soft Systems Studio <noreply@yourdomain.com>

# LiveKit - powers the in-browser "Talk to our AI receptionist" voice demo.
# Server-side only; never expose these with a NEXT_PUBLIC_ prefix.
# From https://cloud.livekit.io -> project -> Settings -> API keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=API...
LIVEKIT_API_SECRET=...
