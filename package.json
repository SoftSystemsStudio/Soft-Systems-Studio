{
  "name": "soft-systems-studio",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@8.11.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "pnpm -r --if-present prisma:generate",
    "setup": "pnpm -w install && pnpm -r build",
    "dev": "pnpm --parallel --filter apps-agent-api --filter frontend dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter apps-agent-api start",
    "lint:fix": "pnpm -r --if-present lint -- --fix",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "pnpm -r test",
    "test:ci": "pnpm -r test -- --ci --coverage",
    "sync-env": "node scripts/sync-env.js",
    "check-env-committed": "node scripts/check-env-committed.js",
    "secretlint": "secretlint \"**/*\" --ignore-path .secretlintignore",
    "scan-placeholders": "node scripts/scan-placeholders.js",
    "check-git-lfs": "node scripts/check-git-lfs.js",
    "security-audit": "bash scripts/security-audit.sh",
    "audit": "pnpm audit && bash scripts/security-audit.sh",
    "prepare": "husky install",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "8.2.0",
    "@types/body-parser": "^1.19.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.5.0",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^8.0.0",
    "jest": "^30.2.0",
    "next": "^16.1.1",
    "prettier": "^3.7.3",
    "secretlint": "8.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.3.0",
    "ws": "^8.18.3"
  }
}
