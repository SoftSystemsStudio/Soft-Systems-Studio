{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "nextjs",
  "_test_deployment": "2026-02-14 - Verifying auto-deploy",
  "buildCommand": "pnpm --filter @softsystems/ui-components build && cd packages/frontend && npx next build",
  "outputDirectory": "packages/frontend/.next",
  "installCommand": "pnpm install",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/cleanup-tokens",
      "schedule": "0 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
