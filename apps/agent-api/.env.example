# Agent API environment example
# Copy this file to `.env` and fill values for local development.
# Keep real secrets out of version control.

# ===========================================
# Databases
# ===========================================
POSTGRES_URL=postgresql://postgres:password@localhost:5432/softsystems
# Alias used by some tools
DATABASE_URL=${POSTGRES_URL}

# ===========================================
# Redis - Choose ONE option:
# ===========================================

# Option 1: Standard Redis (local or Docker)
REDIS_URL=redis://localhost:6379

# Option 2: Upstash Redis (serverless-friendly)
# Get these from https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===========================================
# Upstash QStash (Background Jobs)
# ===========================================
# Get these from https://console.upstash.com/qstash
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ===========================================
# Qdrant (vector DB)
# ===========================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=kb
QDRANT_API_KEY=
QDRANT_USE_HTTPS=false
# Quick health probe timeout for Qdrant (milliseconds). Adjust to your infra.
QDRANT_HEALTH_TIMEOUT_MS=500

# Qdrant network & retry configuration
# General request timeout (ms)
QDRANT_TIMEOUT_MS=30000
# Connect timeout (ms) - currently informational
QDRANT_CONNECT_TIMEOUT_MS=5000
# Retry/backoff
QDRANT_RETRY_MAX=3
QDRANT_RETRY_BASE_MS=250
QDRANT_RETRY_JITTER_MS=100
# Timeout used when checking collection existence (ms)
QDRANT_COLLECTION_CHECK_TIMEOUT_MS=5000

# ===========================================
# OpenAI / LLM
# ===========================================
OPENAI_API_KEY=sk-your-openai-api-key

# ===========================================
# App Config
# ===========================================
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# ===========================================
# Auth (JWT)
# ===========================================
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-secure-random-value-at-least-32-chars
JWT_ALGORITHM=HS256
API_KEY=

# ===========================================
# Sentry Error Tracking
# ===========================================
# Get from: https://sentry.io/settings/projects/[project]/keys/
SENTRY_DSN=
# Environment identifier for Sentry
SENTRY_ENVIRONMENT=development

# ===========================================
# Optional integrations
# ===========================================
SENDGRID_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=